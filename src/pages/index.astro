---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SobreSection from '../components/sections/SobreSection.astro';
import ProgramaSection from '../components/sections/ProgramaSection.astro';
import DiferenciaisSection from '../components/sections/DiferenciaisSection.astro';
import TalentosSection from '../components/sections/TalentosSection.astro';
import RequisitosSection from '../components/sections/RequisitosSection.astro';
---

<Base title="Trainee 2026 Supply Chain | Solar Coca-Cola">
  <Header />

  <main id="main">
    <HeroSection />
    <SobreSection />
    <ProgramaSection />
    <DiferenciaisSection />
    <TalentosSection />
    <RequisitosSection />
  </main>

  <Footer />
</Base>
