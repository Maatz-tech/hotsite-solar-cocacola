---
import '../styles/global.css';
import { SITE_URL, SITE_NAME } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Caminho da imagem OG (1200×630). Relativo a /public. */
  ogImage?: string;
}

const {
  title,
  description = 'Programa de Trainee 2026 da Solar Coca-Cola para Supply Chain. Uma trilha de aprendizagem com desafios práticos e mentoria das principais lideranças.',
  ogImage = '/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <!-- Marca <html> como "com JS" ANTES do primeiro paint: é o que
         permite o estado inicial dos reveals morar no CSS sem quebrar
         a página para quem está sem JS. Ver playbook/05-animacao.md -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Nunito = substituta do Google Fonts para a VAG Rounded Std (licenciada,
         ainda não entregue). Quando os .woff2 chegarem, declarar os @font-face
         em global.css e remover este <link>. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-surface"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
