---
import '../styles/global.css';
import { SITE_URL, SITE_NAME } from '../data/site';
import { asset } from '../lib/url';

// `?url` devolve o caminho final do arquivo processado pelo Vite — com hash e
// já com o `base` aplicado, que é o que o preload precisa apontar.
import fonteLight from '../assets/fonts/vag-rounded-light.woff2?url';
import fonteBold from '../assets/fonts/vag-rounded-bold.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Caminho da imagem OG (1200×630). Relativo a /public. */
  ogImage?: string;
  /** Schemas extras, além do Organization que toda página emite. */
  dadosEstruturados?: Record<string, unknown>[];
}

const {
  title,
  dadosEstruturados = [],
  description = 'Programa de Trainee 2026 da Solar Coca-Cola para Supply Chain. Uma trilha de aprendizagem com desafios práticos e mentoria das principais lideranças.',
  ogImage = '/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    logo: new URL('/images/brand/logo.svg', SITE_URL).href,
  },
  ...dadosEstruturados,
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="96x96" href={asset('/favicon-96.png')} />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <title>{title}</title>

    <!-- Marca <html> como "com JS" ANTES do primeiro paint: é o que
         permite o estado inicial dos reveals morar no CSS sem quebrar
         a página para quem está sem JS. Ver playbook/05-animacao.md -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- A fonte é servida daqui mesmo: sem preconnect nem CSS de terceiro no
         caminho crítico. Só os dois pesos que o design usa. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fonteLight}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fonteBold}
      crossorigin
    />

    <!-- Pré-carrega o LCP de cada breakpoint (o `media` evita baixar os dois). -->
    <link
      rel="preload"
      as="image"
      href={asset('/images/hero/stripes-mobile.webp')}
      media="(max-width: 1023px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={asset('/images/hero/stripes.svg')}
      media="(min-width: 1024px)"
      fetchpriority="high"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
      ))
    }
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-surface"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
