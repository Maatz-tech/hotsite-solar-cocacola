---
import Button from './Button.astro';
import { NAV_LINKS, CTA_URL, CTA_LABEL, SITE_NAME } from '../data/site';
---

<header id="site-header" class="sticky top-0 z-50 bg-surface">
  <div
    class="mx-auto flex h-14 max-w-[1440px] items-center justify-between px-6 lg:h-23 lg:px-28"
  >
    <a href="#top" class="logo-link shrink-0" aria-label={`${SITE_NAME} — topo da página`}>
      <img
        src="/images/brand/logo.svg"
        alt={SITE_NAME}
        width="268"
        height="28"
        class="h-[22px] w-auto lg:h-7"
        fetchpriority="high"
      />
    </a>

    <!-- Nav e CTA formam um bloco só à direita (Figma 4010:419, gap 64). -->
    <div class="hidden items-center gap-16 lg:flex">
      <nav aria-label="Navegação principal">
        <ul class="flex items-center gap-10 text-base font-bold">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="nav-link whitespace-nowrap">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <Button href={CTA_URL}>{CTA_LABEL}</Button>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="-mr-2 flex size-11 items-center justify-center lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        class="size-6"
      >
        <path d="M3 6h18M3 12h18M3 18h18" data-menu-linhas></path>
      </svg>
    </button>
  </div>

</header>

<!--
Drawer mobile. Painel fixo com fundo escurecido, foco preso enquanto aberto e
rolagem da página travada.

Fica FORA do <header> de propósito: o header tem `will-change: transform` e
recebe `transform` ao recolher, e um elemento com transform vira o bloco
contêiner dos descendentes `fixed` — lá dentro, `inset-0` passava a valer a
caixa do header (375×56) em vez da viewport.
-->
<div id="menu-mobile" hidden class="fixed inset-0 z-50 lg:hidden">
  <div data-fundo class="absolute inset-0 bg-ink/50"></div>

  <div
    data-painel
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navegação"
    class="absolute right-0 top-0 flex h-full w-[300px] max-w-[85vw] flex-col bg-surface"
  >
    <div class="flex h-14 items-center justify-between px-6">
      <img
        src="/images/brand/logo.svg"
        alt={SITE_NAME}
        width="268"
        height="28"
        class="h-[22px] w-auto"
      />

      <button
        type="button"
        data-fechar
        class="-mr-2 flex size-11 items-center justify-center"
        aria-label="Fechar menu"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="size-6"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Navegação principal (mobile)" class="flex-1 overflow-y-auto px-6 py-4">
      <ul class="flex flex-col">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="nav-link block py-4 text-xl font-bold">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-ink-20 p-6">
      <Button href={CTA_URL} class="w-full">{CTA_LABEL}</Button>
    </div>
  </div>
</div>


<style>
  /* Drawer: o fundo escurece e o painel entra pela direita. Estado inicial no
     CSS para não piscar antes do script rodar. */
  #menu-mobile [data-fundo] {
    opacity: 0;
    transition: opacity 250ms ease;
  }

  #menu-mobile.aberto [data-fundo] {
    opacity: 1;
  }

  #menu-mobile [data-painel] {
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #menu-mobile.aberto [data-painel] {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #menu-mobile [data-fundo],
    #menu-mobile [data-painel] {
      transition: none;
    }
  }

  /* O reveal mora no CSS para não piscar antes do script rodar. A transição
     só existe com JS ativo — sem ele o header fica parado e visível. */
  #site-header {
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
    will-change: transform;
  }

  #site-header.recolhido {
    transform: translateY(-100%);
  }

  /* Revelado no meio da página, ele flutua sobre a seção: precisa de um
     apoio visual, senão some no fundo claro. */
  #site-header.flutuando {
    box-shadow:
      0 1px 0 var(--color-ink-08),
      0 8px 24px rgb(40 40 40 / 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition: none;
    }
  }
</style>

<script>
  const botao = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  if (botao && menu) {
    const painel = menu.querySelector<HTMLElement>('[data-painel]')!;
    const menosMovimento = matchMedia('(prefers-reduced-motion: reduce)');
    const FOCAVEIS = 'a[href], button:not([disabled])';

    let fechando: number | undefined;

    const definir = (aberto: boolean) => {
      clearTimeout(fechando);
      botao.setAttribute('aria-expanded', String(aberto));

      if (aberto) {
        menu.hidden = false;
        // Trava a rolagem da página sem deixar o layout pular quando existe
        // barra de rolagem visível.
        const barra = window.innerWidth - document.documentElement.clientWidth;
        document.body.style.overflow = 'hidden';
        if (barra > 0) document.body.style.paddingRight = `${barra}px`;
        // Espera um frame: sem isso a transição não roda, o painel já nasce aberto.
        requestAnimationFrame(() => menu.classList.add('aberto'));
        painel.querySelector<HTMLElement>(FOCAVEIS)?.focus();
      } else {
        menu.classList.remove('aberto');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
        const espera = menosMovimento.matches ? 0 : 300;
        fechando = window.setTimeout(() => {
          menu.hidden = true;
        }, espera);
      }
    };

    const estaAberto = () => botao.getAttribute('aria-expanded') === 'true';

    botao.addEventListener('click', () => definir(!estaAberto()));
    menu.querySelector('[data-fechar]')?.addEventListener('click', () => {
      definir(false);
      botao.focus();
    });
    menu.querySelector('[data-fundo]')?.addEventListener('click', () => definir(false));

    // Clicar num link navega e fecha.
    painel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) definir(false);
    });

    document.addEventListener('keydown', (e) => {
      if (!estaAberto()) return;

      if (e.key === 'Escape') {
        definir(false);
        botao.focus();
        return;
      }

      // Prende o Tab no painel: sem isso o foco escapa para a página atrás,
      // que está visualmente coberta.
      if (e.key === 'Tab') {
        const alvos = Array.from(painel.querySelectorAll<HTMLElement>(FOCAVEIS));
        if (!alvos.length) return;
        const primeiro = alvos[0];
        const ultimo = alvos[alvos.length - 1];
        if (e.shiftKey && document.activeElement === primeiro) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primeiro.focus();
        }
      }
    });

    // Voltar pro desktop com o menu aberto deixaria a rolagem travada.
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && estaAberto()) definir(false);
    });
  }

  /**
   * Header que recolhe ao descer e reaparece ao subir.
   *
   * Nunca recolhe: no topo da página, com o menu mobile aberto (o botão de
   * fechar mora nele) e com `prefers-reduced-motion` — aí ele fica parado.
   */
  const cabecalho = document.getElementById('site-header');

  if (cabecalho) {
    const menosMovimento = matchMedia('(prefers-reduced-motion: reduce)');
    const FOLGA = 4; // ignora tremidas de 1-2px do trackpad

    let ultimo = window.scrollY;
    let agendado = false;

    const avaliar = () => {
      agendado = false;
      const y = window.scrollY;
      const altura = cabecalho.offsetHeight;
      const menuAberto = menu ? !menu.hidden : false;

      if (y <= altura || menuAberto || menosMovimento.matches) {
        cabecalho.classList.remove('recolhido');
      } else if (y > ultimo + FOLGA) {
        cabecalho.classList.add('recolhido');
      } else if (y < ultimo - FOLGA) {
        cabecalho.classList.remove('recolhido');
      }

      cabecalho.classList.toggle('flutuando', y > altura);
      ultimo = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (agendado) return;
        agendado = true;
        requestAnimationFrame(avaliar);
      },
      { passive: true }
    );

    // Abrir o menu com o header recolhido esconderia o próprio botão de fechar.
    botao?.addEventListener('click', () => cabecalho.classList.remove('recolhido'));

    avaliar();
  }
</script>
