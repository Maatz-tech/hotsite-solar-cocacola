---
/**
 * Aviso de inscrições encerradas. Renderizado uma vez na página; todos os CTAs
 * marcados com `data-abre-aviso` o abrem.
 *
 * Mesmo padrão do hotsite da Unilever (estagiounilever.com.br): `<dialog>`
 * nativo com `showModal()`, que já traz foco preso, Esc e backdrop sem JS
 * nosso. O visual segue os tokens daqui — borda e sombra sólida da marca.
 */
import { SITE_NAME, ENCERRADO_LABEL } from '../data/site';
import { PERIODO_INSCRICAO } from '../data/vaga';
---

<dialog id="aviso-inscricoes" class="aviso" aria-labelledby="aviso-titulo">
  <div class="aviso__cartao">
    <p class="eyebrow">Programa de Trainee 2026 {SITE_NAME}</p>

    <h2 id="aviso-titulo" class="pt-1 text-2xl font-bold leading-tight lg:text-[32px]">
      As inscrições foram encerradas
    </h2>

    <p class="pt-4 text-ink-70">
      O prazo foi <strong class="text-ink"
        >de {PERIODO_INSCRICAO.inicio} a {PERIODO_INSCRICAO.fim}</strong
      >, e o formulário não recebe mais candidaturas.
    </p>

    <div class="pt-8">
      <button type="button" class="btn btn-primary btn-md" data-fecha-aviso>Entendi</button>
    </div>
  </div>
</dialog>

<style>
  /* O <dialog> é só o trilho de centralização; o cartão é quem tem a caixa. */
  .aviso {
    margin: auto;
    border: 0;
    padding: 24px;
    background: transparent;
    max-width: 100vw;
    max-height: 100dvh;
    overflow: visible;
  }

  .aviso::backdrop {
    background: rgb(40 40 40 / 0.5);
  }

  .aviso__cartao {
    width: min(560px, 100%);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-btn);
    background: var(--color-surface);
    box-shadow: var(--shadow-solid-lg);
    padding: 32px;
  }

  @media (min-width: 640px) {
    .aviso__cartao {
      padding: 40px;
    }
  }

  /* Entrada: o cartão sobe um pouco ao abrir. `allow-discrete` é o que faz a
     transição rodar mesmo com o display saindo de `none`. */
  .aviso[open] .aviso__cartao {
    animation: aviso-entra 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes aviso-entra {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aviso[open] .aviso__cartao {
      animation: none;
    }
  }
</style>

<script>
  const aviso = document.getElementById('aviso-inscricoes') as HTMLDialogElement | null;

  if (aviso) {
    // Delegado: pega os CTAs de todas as seções sem cada uma registrar o seu.
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-abre-aviso]')) return;
      e.preventDefault();
      aviso.showModal();
    });

    for (const b of aviso.querySelectorAll('[data-fecha-aviso]')) {
      b.addEventListener('click', () => aviso.close());
    }

    // Clique no backdrop: o alvo é o próprio <dialog>, não o cartão.
    aviso.addEventListener('click', (e) => {
      if (e.target === aviso) aviso.close();
    });
  }
</script>
