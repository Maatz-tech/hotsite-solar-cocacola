---
import { asset } from '../../lib/url';
/**
 * Hero — Figma desktop 4010:290 · mobile 4029:2268.
 *
 * O palco tem altura fixa nos dois breakpoints (o design é de largura fixa),
 * e toda a arte é ancorada às bordas para degradar bem entre 1024 e 1440.
 */
import Button from '../Button.astro';
import { CTA_URL } from '../../data/site';
---

<section id="top" class="px-3 lg:px-10 lg:py-6">
  <div
    class="relative mx-auto h-[814px] max-w-[1360px] overflow-hidden rounded-[32px] bg-surface-alt lg:h-[570px]"
  >
    <!--
      Curvas de nível da garrafa. No desktop é vetor (escala sem perder
      nitidez); no mobile vai rasterizado: são 67 paths e decodificá-los
      custava ~2s de LCP em CPU lenta.
    -->
    <picture>
      <source media="(min-width: 1024px)" srcset={`${asset("/images/hero/stripes.svg")}`} />
      <img
        src={asset('/images/hero/stripes-mobile.webp')}
        alt=""
        aria-hidden="true"
        width="351"
        height="819"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 size-full object-cover"
      />
    </picture>

    <!--
      Anel vermelho. No Figma é um círculo com TRAÇO, não dois círculos
      sobrepostos: `stroke-width` 120 sobre r=359 no desktop (4012:936) e 64
      sobre r=197 no mobile (4029:2377). Reproduzido com `border`, que deixa o
      furo transparente e as curvas de nível aparecerem através dele.
    -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-[603px] size-[458px] -translate-x-1/2 rounded-full border-[64px] border-brand lg:left-auto lg:right-[406px] lg:top-[163px] lg:size-[838px] lg:translate-x-1/2 lg:border-[120px]"
    >
    </div>

    <!--
      Foto: o recorte transparente original (as pessoas sem fundo), com o
      mesmo enquadramento do Figma nos dois breakpoints — 156.44% de largura,
      deslocada -28.22%. O export achatado do node perdia o alpha e escondia
      o anel vermelho por trás das pessoas.
    -->
    <div
      class="pointer-events-none absolute bottom-[-11px] left-1/2 h-[329px] w-[336px] -translate-x-1/2 overflow-hidden lg:bottom-0 lg:left-auto lg:right-[98px] lg:top-[-33px] lg:h-[603px] lg:w-[616px] lg:translate-x-0"
    >
      <img
        src={asset('/images/hero/pessoas.webp')}
        srcset={`${asset("/images/hero/pessoas-760.webp")} 760w, ${asset("/images/hero/pessoas.webp")} 1449w`}
        sizes="(min-width: 1024px) 964px, 526px"
        width="1449"
        height="1086"
        alt="Dois jovens trainees da Solar Coca-Cola sorrindo, um deles segurando uma garrafa de Coca-Cola"
        loading="eager"
        class="absolute left-[-28.22%] top-0 h-auto w-[156.44%] max-w-none"
      />
    </div>

    <div
      class="absolute left-5 top-16 flex w-[311px] flex-col gap-8 lg:left-[72px] lg:top-1/2 lg:w-[406px] lg:-translate-y-1/2 lg:gap-10"
    >
      <div class="flex flex-col gap-8">
        <div class="flex flex-col items-start gap-6 lg:flex-row lg:gap-8">
          <p
            class="flex h-11 shrink-0 items-center justify-center gap-2.5 rounded-btn bg-ink p-3 text-xl font-bold text-surface"
            data-reveal
          >
            <img
              src={asset('/images/hero/setas.webp')}
              alt=""
              aria-hidden="true"
              width="52"
              height="16"
              class="h-4 w-13"
            />
            Supply Chain
          </p>

          <p
            class="flex h-11 shrink-0 items-center rounded-btn border border-ink bg-surface px-4 text-lg font-light text-brand"
            data-reveal
          >
            Inscrições até 28 de setembro
          </p>
        </div>

        <h1 class="flex flex-col gap-8">
          <span class="display block leading-[0.908] text-brand max-lg:text-[80px] max-lg:leading-[0.925]">Trainee</span>
          <!--
            Este logo já traz "Paixão que transforma / Sede que impulsiona"
            vetorizada abaixo da marca — por isso o parágrafo com a mesma frase
            saiu daqui. Escalado por largura (a marca ocupa os mesmos 277/363px
            de antes) e não por altura, que agora acompanha a assinatura.
          -->
          <img
            src={asset('/images/brand/logo-tagline.svg')}
            alt="Solar Coca-Cola — Paixão que transforma, sede que impulsiona"
            width="379"
            height="130"
            class="h-auto w-[277px] self-start lg:w-[363px]"
          />
        </h1>
      </div>

      <div data-reveal>
        <Button href={CTA_URL}>
          <span class="lg:hidden">Inscreva-se agora!</span>
          <span class="max-lg:hidden">Inscreva-se</span>
        </Button>
      </div>

    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from '../../lib/motion';

  // Acima da dobra: só o que NÃO é LCP entra com reveal — o "Trainee", o logo
  // e a foto aparecem imediatos. Ver playbook/09-qa-erros-comuns.md#qa-006
  revealOnScroll('#top [data-reveal]', { atraso: 0.1 });
</script>
