---
import { asset } from '../../lib/url';
/**
 * Hero — Figma desktop 4010:290 · mobile 4029:2268.
 *
 * O palco tem altura fixa nos dois breakpoints porque o design é de largura
 * fixa: 1360x610 no desktop. Entre 1024 e 1440 essa composição não reflui —
 * ela encolhe inteira (ver `.hero-cena` no <style>). Tentar ancorar cada peça
 * na borda fazia a foto entrar por cima do "Trainee" por volta de 1100.
 * Ver playbook/09-qa-erros-comuns.md#qa-032
 */
import Button from '../Button.astro';
import { CTA_URL } from '../../data/site';
---

<section id="top" class="px-3 lg:px-10 lg:py-6">
  <div class="hero-quadro relative mx-auto max-w-[1360px]">
  <div class="hero-palco relative h-[814px] overflow-hidden rounded-[32px] bg-surface-alt">
    <div class="hero-cena absolute inset-0">
    <!--
      Curvas de nível da garrafa. No desktop é vetor (escala sem perder
      nitidez); no mobile vai rasterizado: são 67 paths e decodificá-los
      custava ~2s de LCP em CPU lenta.
    -->
    <picture>
      <source media="(min-width: 1024px)" srcset={`${asset("/images/hero/stripes.svg")}`} />
      <img
        src={asset('/images/hero/stripes-mobile.webp')}
        alt=""
        aria-hidden="true"
        width="702"
        height="1628"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 size-full object-cover"
      />
    </picture>

    <!--
      Esmaecimento das curvas de nível: no Figma (4010:715) um gradiente radial
      #f1f1f1 transparente→opaco por cima das linhas, centrado no card, esconde
      as curvas perto da borda e deixa só o miolo visível. Sem isso o fundo
      inteiro fica com a mesma densidade de linha — mais "carregado" que o
      Figma. Só no desktop: no mobile (4029:2270) o Figma já exporta as linhas
      num único grupo a 20% de opacidade, sem gradiente por cima.
    -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background: radial-gradient(ellipse 877px 393px at 50% 50%, rgba(241,241,241,0) 0%, rgb(241,241,241) 100%);"
    >
    </div>

    <!--
      Anel vermelho. No Figma é um círculo com TRAÇO, não dois círculos
      sobrepostos: `stroke-width` 120 sobre r=359 no desktop (4012:936) e 64
      sobre r=197 no mobile (4029:2377). Reproduzido com `border`, que deixa o
      furo transparente e as curvas de nível aparecerem através dele.
    -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-[603px] size-[458px] -translate-x-1/2 rounded-full border-[64px] border-brand lg:left-auto lg:right-[406px] lg:top-[203px] lg:size-[838px] lg:translate-x-1/2 lg:border-[120px]"
    >
    </div>

    <!--
      Foto: o recorte transparente original (as pessoas sem fundo), com o
      mesmo enquadramento do Figma nos dois breakpoints — 156.44% de largura,
      deslocada -28.22%. O export achatado do node perdia o alpha e escondia
      o anel vermelho por trás das pessoas.
    -->
    <div
      class="pointer-events-none absolute bottom-[-11px] left-1/2 h-[329px] w-[336px] -translate-x-1/2 overflow-hidden lg:bottom-0 lg:left-auto lg:right-[98px] lg:top-[7px] lg:h-[603px] lg:w-[616px] lg:translate-x-0"
    >
      <img
        src={asset('/images/hero/pessoas.webp')}
        srcset={`${asset("/images/hero/pessoas-760.webp")} 760w, ${asset("/images/hero/pessoas.webp")} 1449w`}
        sizes="(min-width: 1024px) 964px, 526px"
        width="1449"
        height="1086"
        alt="Dois jovens trainees da Solar Coca-Cola sorrindo, um deles segurando uma garrafa de Coca-Cola"
        loading="eager"
        class="absolute left-[-28.22%] top-0 h-auto w-[156.44%] max-w-none"
      />
    </div>

    <div
      class="absolute left-5 top-16 flex w-[311px] flex-col items-center gap-8 max-lg:sm:left-1/2 max-lg:sm:-translate-x-1/2 lg:left-[72px] lg:top-[70px] lg:w-[484px] lg:gap-10"
    >
      <div class="flex w-full flex-col items-center gap-8">
        <div class="flex flex-col items-center gap-4 lg:flex-row lg:gap-8">
          <p
            class="flex h-11 shrink-0 items-center justify-center gap-2.5 rounded-btn bg-ink p-3 text-xl font-bold text-surface"
            data-reveal
          >
            <img
              src={asset('/images/hero/setas.webp')}
              alt=""
              aria-hidden="true"
              width="52"
              height="16"
              class="h-4 w-13"
            />
            Supply Chain
          </p>

          <p
            class="flex h-11 w-full shrink-0 items-center justify-center rounded-btn border border-ink bg-surface px-4 text-lg font-light text-brand lg:w-auto"
            data-reveal
          >
            Inscrições até 28 de setembro
          </p>
        </div>

        <h1 class="flex flex-col items-center gap-8">
          <span class="display block leading-[0.908] text-brand max-lg:text-[72px] max-lg:leading-[0.925] lg:text-[96px]">Trainee</span>
          <img
            src={asset('/images/hero/logo-assinatura.svg')}
            alt="Solar Coca-Cola — Paixão que transforma. Sede que impulsiona."
            width="379"
            height="130"
            class="h-[90px] w-auto lg:h-[130px]"
          />
        </h1>
      </div>

      <div class="flex w-full items-center justify-center" data-reveal>
        <Button href={CTA_URL}>Inscreva-se agora!</Button>
      </div>
    </div>
    </div>
  </div>

  <!--
    Carrossel de EVPs no desktop (Figma 4199:199). Fica FORA do card com
    overflow-hidden de propósito: no Figma ele estoura 56px por baixo da
    borda do card (554→666 de 610 de altura), sobrepondo o início da seção
    "Sobre". Centralizado nos 1360px do card (908 de largura, mesma folga dos
    dois lados: (1360-908)/2 = 226).
  -->
  <div class="hidden lg:-mt-14 lg:block" data-reveal>
    <div class="mx-auto flex w-[908px] max-w-full items-center justify-between rounded-3xl border border-[#d4d4d4] bg-surface px-20 py-6 max-wide:gap-6 max-wide:px-10">
      <img src={asset('/images/hero/evp2.svg')} alt="Propósito nos faz Solar" width="163" height="48" class="h-12 w-auto" />
      <div class="h-16 border-l border-[#d4d4d4]"></div>
      <img src={asset('/images/hero/evp1.svg')} alt="Desenvolvimento nos faz Solar" width="176" height="48" class="h-12 w-auto" />
      <div class="h-16 border-l border-[#d4d4d4]"></div>
      <img src={asset('/images/hero/evp3.svg')} alt="Performance nos faz Solar" width="153" height="48" class="h-12 w-auto" />
    </div>
  </div>
  </div>

  <!--
    Carrossel de EVPs no mobile (Figma 4200:553) — é um irmão logo abaixo do
    card do hero, não faz parte dele: sangra de borda a borda (x=0, w=375,
    igual às seções que não têm margem lateral no mobile) e reusa o mesmo
    layout do desktop (748px de conteúdo), só que cabendo num frame de 375px.
    Vira uma esteira: o trilho é o conjunto de itens duplicado (2×) andando em
    `translateX` contínuo até -50% — na hora que o primeiro conjunto sai
    totalmente de cena, o segundo está seguindo o exato mesmo desenho, então o
    corte é imperceptível e o loop nunca "reseta" visivelmente.
  -->
  <div class="evp-carrossel-mobile -mx-3 overflow-hidden bg-surface pt-10 lg:hidden">
    <ul class="evp-trilho-mobile flex w-max gap-16">
      {
        [0, 1].map((copia) => (
          <>
            <li class="flex shrink-0 items-center" aria-hidden={copia === 1}>
              <img src={asset('/images/hero/evp2.svg')} alt="Propósito nos faz Solar" width="163" height="48" class="h-12 w-auto" />
            </li>
            <li class="flex shrink-0 items-center" aria-hidden={copia === 1}>
              <img src={asset('/images/hero/evp1.svg')} alt="Desenvolvimento nos faz Solar" width="176" height="48" class="h-12 w-auto" />
            </li>
            <li class="flex shrink-0 items-center" aria-hidden={copia === 1}>
              <img src={asset('/images/hero/evp3.svg')} alt="Performance nos faz Solar" width="153" height="48" class="h-12 w-auto" />
            </li>
          </>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
    Entre 1024 e 1440 o hero encolhe inteiro em vez de refluir: a cena mantém
    os 1360x610 do Figma e leva um `scale`, então nenhuma peça troca de lugar
    em relação às outras. `cqw` (e não `vw`) porque a barra de rolagem entra
    em `100vw` no Chrome do Windows e o card estouraria a caixa por alguns px.
  */
  .hero-quadro {
    container-type: inline-size;
  }

  @media (width >= 64rem) {
    .hero-palco {
      /* Razão largura-disponível ÷ 1360 como número puro. `calc(100cqw/1360)`
         devolveria um comprimento, e comprimento não entra em `scale()`;
         `tan(atan2(a, b))` é a forma de dividir dois comprimentos em CSS e sair
         com um número. Teto em 1: acima de 1440 o hero fica no tamanho do Figma. */
      --escala: min(1, tan(atan2(100cqw, 1360px)));
      height: calc(610px * var(--escala));
    }

    .hero-cena {
      inset: 0 auto auto 0;
      width: 1360px;
      height: 610px;
      transform: scale(var(--escala));
      transform-origin: top left;
    }
  }

  .evp-trilho-mobile {
    animation: evp-marquee 28s linear infinite;
  }

  @keyframes evp-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evp-trilho-mobile {
      animation: none;
    }
  }
</style>

<script>
  import { revealOnScroll } from '../../lib/motion';

  // Acima da dobra: só o que NÃO é LCP entra com reveal — o "Trainee", o logo
  // e a foto aparecem imediatos. Ver playbook/09-qa-erros-comuns.md#qa-006
  revealOnScroll('#top [data-reveal]', { atraso: 0.1 });
</script>
