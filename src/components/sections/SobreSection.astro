---
import { asset } from '../../lib/url';
/**
 * Sobre a Solar — Figma desktop 4010:796 · mobile 4031:2385.
 *
 * A ordem muda entre breakpoints: no mobile o título vem antes das fotos,
 * no desktop as fotos ocupam a coluna da esquerda inteira. Resolvido com
 * grid (posicionamento) em vez de duplicar markup.
 */
import Button from '../Button.astro';
import SectionHeader from '../SectionHeader.astro';
import { CTA_URL } from '../../data/site';

const fotos = [
  {
    src: '/images/sobre/foto-1.webp',
    alt: 'Duas colaboradoras da Solar Coca-Cola sorrindo e segurando garrafas de Coca-Cola',
  },
  {
    src: '/images/sobre/foto-2.webp',
    alt: 'Mãos de várias pessoas brindando com garrafas de Coca-Cola',
  },
];
---

<section id="sobre" class="respiro-x py-16 lg:pb-25 lg:pt-[122px]">
  <div
    class="mx-auto grid max-w-lp gap-10 lg:grid-cols-[488px_1fr] lg:gap-x-20 lg:gap-y-8"
  >
    <SectionHeader
      eyebrow="Solar Coca-Cola"
      title="Uma empresa brasileira, feita de talento, paixão e de pessoas Solares!"
      class="lg:col-start-2 lg:row-start-1"
    />

    <div
      class="flex flex-col gap-6 lg:col-start-1 lg:row-start-1 lg:row-span-3 lg:self-start"
      data-reveal-stagger
    >
      <div class="grid grid-cols-2 gap-6">
        {
          fotos.map((foto) => (
            <img
              src={asset(foto.src)}
              srcset={`${asset(foto.src.replace('.webp', '-sm.webp'))} 400w, ${asset(foto.src)} 500w`}
              sizes="(min-width: 1024px) 232px, calc(50vw - 36px)"
              alt={foto.alt}
              width="232"
              height="357"
              loading="lazy"
              class="h-[357px] w-full rounded-card object-cover max-lg:h-[240px]"
            />
          ))
        }
      </div>

      <img
        src={asset('/images/sobre/card-icones.webp')}
        srcset={`${asset("/images/sobre/card-icones-sm.webp")} 800w, ${asset("/images/sobre/card-icones.webp")} 1000w`}
        sizes="(min-width: 1024px) 488px, calc(100vw - 48px)"
        alt=""
        aria-hidden="true"
        width="488"
        height="207"
        loading="lazy"
        class="w-full rounded-card"
      />
    </div>

    <div class="rich-text lg:col-start-2 lg:row-start-2" data-reveal>
      <p>
        Somos uma das maiores fabricantes do <strong class="font-bold"
          >Sistema Coca-Cola</strong
        > no mundo e contamos com 13 fábricas espalhadas pelo Brasil. Com cerca de
        120 centros de distribuição, entre próprios e terceirizados, somos responsáveis
        pela produção e distribuição de sorrisos para aproximadamente 380 mil pontos de
        venda, impactando positivamente a vida de mais de 80 milhões de brasileiros.
      </p>
      <p>
        A sustentabilidade está presente na nossa relação com as pessoas, com as
        comunidades, com os parceiros e com o meio ambiente. Por meio de diversas
        iniciativas - dentro e fora das nossas fábricas - trabalhamos para gerar
        valor e contribuir para a construção de um futuro melhor nos territórios
        onde estamos presentes.
      </p>
      <p>
        Somos movidos por um propósito que conecta nossas pessoas em fábricas,
        centros de distribuição e escritórios: transformar positivamente a
        realidade onde atuamos. É esse jeito de fazer acontecer, com Paixão,
        Valorização das pessoas, Sentimento de dono e Protagonismo, que
        impulsiona a jornada da Solar todos os dias.
      </p>
      <p class="text-ink"><strong>Vem fazer parte dessa história com a gente!</strong></p>
    </div>

    <div class="lg:col-start-2 lg:row-start-3" data-reveal>
      <Button href={CTA_URL}>Dê um gás na sua carreira!</Button>
    </div>
  </div>
</section>

<script>
  import { revealWords, revealOnScroll, revealStagger } from '../../lib/motion';
  revealWords('#sobre [data-reveal-words]');
  revealOnScroll('#sobre [data-reveal]', { atraso: 0.15 });
  revealStagger('#sobre [data-reveal-stagger]');
</script>
