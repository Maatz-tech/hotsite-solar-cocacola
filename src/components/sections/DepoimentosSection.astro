---
import { asset } from '../../lib/url';
/**
 * Depoimentos — Figma desktop 4016:377 · mobile 4031:3255.
 * Cards em 4102:120 · 127 · 141 · 149 · 156.
 *
 * Carrossel de um card por página, com scroll-snap nativo: setas, bolinhas,
 * arrasto e autoplay só mandam o trilho para o índice certo (ver lib/carrossel).
 * Sem biblioteca, funciona com teclado, com toque e sem JS.
 * Ver playbook/09-qa-erros-comuns.md#qa-035
 */
import RevealText from '../RevealText.astro';

const depoimentos = [
  {
    foto: '/images/depoimentos/luiz.webp',
    nome: 'Luiz Felipe Ribas Motta',
    cargo: 'Coordenador de Estoque',
    citacao: `Ser trainee na Solar é acelerar o desenvolvimento profissional por meio de projetos estratégicos, mentorias e treinamentos de alto nível. <strong>O programa fortaleceu minha capacidade de liderar iniciativas, enfrentar desafios complexos e gerar valor para o negócio</strong> por meio de dados, transformação digital e melhoria contínua.`,
  },
  {
    foto: '/images/depoimentos/beatriz.webp',
    nome: 'Beatriz Ribeiro Pianco da Silva',
    cargo: 'Especialista de Marketing',
    citacao: `“Vim de fora do mercado de bens de consumo e encontrei um ambiente acolhedor, onde aprendi na prática com times dispostos a ensinar. Ter curiosidade e resiliência para entender que não precisamos ter todas as respostas foi fundamental. <strong>O que mais marcou minha experiência foi estar cercada de pessoas colaborativas, dispostas a compartilhar conhecimento</strong>. Estar conectada com as pessoas certas me fez aprender com os outros e me colocou em prontidão para ensinar os que virão.”`,
  },
  {
    foto: '/images/depoimentos/carlos.webp',
    nome: 'Carlos Antonio Formenton Barp',
    cargo: 'Coordenador Financeiro',
    citacao: `“Ser trainee na Solar é viver um aprendizado acelerado, com desafios reais, autonomia e contato com pessoas que te fazem crescer. É a oportunidade de conhecer o negócio de ponta a ponta e construir uma visão estratégica da companhia. Aprendi a enxergar a empresa de forma integrada, entendendo como diferentes áreas se conectam para gerar resultados. Mais do que processos, <strong>o programa me ensinou a liderar, influenciar e aprender continuamente</strong>.”`,
  },
  {
    foto: '/images/depoimentos/keila.webp',
    nome: 'Keila Leticia Fernandes Vidal',
    cargo: 'Especialista de Marketing',
    citacao: `“Desde o primeiro dia somos incentivados a liderar nossa jornada. Aprendi que o caminho é desafiador e que nem sempre vamos acertar… o importante é ter humildade para aprender com os erros. Entrei em Finanças e hoje estou em Key Accounts, uma área que nem estava nos meus planos, mas onde me encontrei. <strong>Aprendi a lidar com mudanças, resolver problemas buscando a causa raiz e entender que a empresa é feita de pessoas para pessoas</strong>.”`,
  },
  {
    foto: '/images/depoimentos/augusto.webp',
    nome: 'Augusto da Rocha Simas Junior',
    cargo: 'Especialista de Marketing',
    citacao: `“É se desafiar constantemente, liderando projetos e vivendo mudanças, pressão e responsabilidades que exigem maturidade. Tudo isso amparado por uma forte trilha de desenvolvimento, treinamentos, mentorias e líderes inspiradores. Aprendi a entregar resultados em ambientes de alta complexidade e velocidade, liderando a mim mesmo e multiplicando a cultura da empresa.<strong> No fim, ser Trainee é transformar potencial em resultado</strong>.”`,
  },
];

const decorativos = [
  { src: '/images/icones/garrafa-tampa.svg', w: 31, h: 52 },
  { src: '/images/icones/garrafa.svg', w: 13, h: 48 },
  { src: '/images/icones/copo.svg', w: 29, h: 59 },
];
---

<!-- Sem margem lateral: no mobile só o hero tem (Figma). -->
<section id="depoimentos">
  <div
    class="mx-auto grid max-w-[1440px] gap-10 rounded-3xl lg:rounded-[40px] bg-surface-alt respiro-x py-16 lg:grid-cols-[220px_1fr] lg:gap-10 lg:py-25 wide:grid-cols-[280px_1fr] wide:gap-16"
  >
    <div class="flex flex-col justify-between gap-10">
      <div class="flex flex-col gap-6">
        <!--
          Um título só nos dois breakpoints, a pedido do cliente: o Figma
          mobile trazia "O que nossas pessoas Solares têm a dizer". O tamanho
          segue responsivo (32 no mobile, 40 no desktop).
        -->
        <RevealText
          as="h2"
          class="text-[32px] font-bold leading-[1.19] text-black max-lg:text-center lg:text-[40px] lg:leading-[48px]"
          text="Talentos que passaram pelo programa"
        />

        <div class="flex gap-3 max-lg:hidden">
          <button
            type="button"
            data-carrossel="anterior"
            class="seta-carrossel"
            aria-label="Depoimento anterior"
            aria-controls="trilho-depoimentos"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6 rotate-180">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
          <button
            type="button"
            data-carrossel="proximo"
            class="seta-carrossel"
            aria-label="Próximo depoimento"
            aria-controls="trilho-depoimentos"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-6">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        aria-hidden="true"
        class="flex w-full items-end justify-center gap-8 rounded-pill border-[1.06px] border-brand px-13 py-2 max-lg:hidden"
      >
        {
          decorativos.map((d) => (
            <img src={asset(d.src)} alt="" width={d.w} height={d.h} style={`height:${d.h}px`} class="w-auto" loading="lazy" />
          ))
        }
      </div>
    </div>

    <div
      id="trilho-depoimentos"
      class="trilho-arrastavel flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth max-lg:-mx-6 max-lg:w-[calc(100%+48px)] max-lg:scroll-pl-6 max-lg:px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      tabindex="0"
      role="group"
      aria-roledescription="carrossel"
      aria-label="Depoimentos de ex-trainees"
    >
      {
        depoimentos.map((d, i) => (
          <article
            class="flex w-full shrink-0 snap-start snap-always flex-col items-start gap-10 rounded-card bg-surface p-6 lg:flex-row lg:gap-8 lg:p-8 wide:gap-10 wide:p-10"
            aria-roledescription="slide"
            aria-label={`${i + 1} de ${depoimentos.length}`}
          >
            <img
              src={asset(d.foto)}
              srcset={`${asset(d.foto.replace('.webp', '-sm.webp'))} 620w, ${asset(d.foto)} 918w`}
              sizes="(min-width: 1440px) 300px, (min-width: 1024px) 240px, calc(100vw - 120px)"
              width="300"
              height="400"
              alt={d.nome}
              loading="lazy"
              class="h-[340px] w-[240px] shrink-0 rounded-btn border border-ink object-cover object-top shadow-solid-lg max-lg:aspect-[279/227] max-lg:h-auto max-lg:w-full wide:h-[400px] wide:w-[300px]"
            />

            <div class="flex flex-1 flex-col justify-between gap-8 self-stretch">
              <p class="text-lg leading-[1.5] text-ink-70 max-lg:text-base [&>strong]:font-bold [&>strong]:text-brand" set:html={d.citacao} />

              <div class="flex flex-col gap-1">
                <p class="text-xl font-bold leading-[1.3]">{d.nome}</p>
                <p class="text-lg leading-[1.3]">{d.cargo}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Mobile: indicadores no lugar das setas (Figma 4031:3319). -->
    <ul id="pontos-depoimentos" class="flex items-center justify-center gap-1 lg:hidden">
      {
        depoimentos.map((d, i) => (
          <li>
            <button
              type="button"
              class="ponto-carrossel block"
              aria-current="false"
              aria-label={`Ver depoimento de ${d.nome}`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { revealWords } from '../../lib/motion';
  import { arrastavelComMouse, autoplay, paginar } from '../../lib/carrossel';
  revealWords('#depoimentos [data-reveal-words]');

  const trilho = document.getElementById('trilho-depoimentos');

  if (trilho) {
    // Setas, bolinhas e arrasto falam em índice de card — nunca em pixels.
    const carrossel = paginar(trilho);

    const anterior = document.querySelector<HTMLButtonElement>('[data-carrossel="anterior"]');
    const proximo = document.querySelector<HTMLButtonElement>('[data-carrossel="proximo"]');
    const bolinhas = Array.from(
      document.querySelectorAll<HTMLButtonElement>('#pontos-depoimentos button')
    );

    // Passa sozinho; qualquer troca manual reinicia a contagem.
    const rodizio = autoplay(trilho, carrossel);
    const trocar = (i: number) => {
      carrossel.irPara(i);
      rodizio?.adiar();
    };

    anterior?.addEventListener('click', () => trocar(carrossel.indice() - 1));
    proximo?.addEventListener('click', () => trocar(carrossel.indice() + 1));
    bolinhas.forEach((b, i) => b.addEventListener('click', () => trocar(i)));

    // As setas mostram onde dá pra ir: na ponta do trilho a seta apaga.
    carrossel.aoMudar((indice, total) => {
      if (anterior) anterior.disabled = indice === 0;
      if (proximo) proximo.disabled = indice === total - 1;
      bolinhas.forEach((b, i) => b.setAttribute('aria-current', String(i === indice)));
    });

    // No desktop as setas eram a única forma de trocar: o mouse não arrasta
    // contêiner de scroll sozinho.
    arrastavelComMouse(trilho, carrossel);
  }
</script>
