---
/** Quem procuramos — Figma desktop 4028:1819 · mobile 4031:2641. */
import Button from '../Button.astro';
import Eyebrow from '../Eyebrow.astro';
import RevealText from '../RevealText.astro';
import Estrela from '../icons/Estrela.astro';
import { CTA_URL } from '../../data/site';
---

<section id="talentos" class="relative px-6 py-16 lg:px-28 lg:py-25">
  <Estrela class="absolute right-20 top-[62px] size-26 text-brand max-lg:right-4 max-lg:top-8 max-lg:size-16" />

  <div class="mx-auto grid max-w-lp gap-8 lg:grid-cols-[1fr_488px] lg:items-start lg:gap-x-20">
    <div class="flex flex-col items-start gap-8">
      <div class="flex flex-col items-start gap-4">
        <Eyebrow data-reveal>talentos</Eyebrow>
        <RevealText as="h2" class="h2" text="Quem procuramos para o time de Supply Chain?" />
      </div>

      <p class="rich-text" data-reveal>
        Buscamos talentos com sede que impulsiona e que enxergam cada desafio
        como um aprendizado e uma oportunidade de crescimento. Se você tem paixão
        por superar metas, assumir o protagonismo da sua carreira e quer
        construir uma trajetória de conquistas, o seu lugar é aqui!
      </p>

      <div data-reveal>
        <Button href={CTA_URL}>Quero ser Trainee Solar Coca-Cola!</Button>
      </div>
    </div>

    <img
      src="/images/talentos/selfie.webp"
      width="488"
      height="345"
      alt="Grupo de cinco jovens da Solar Coca-Cola tirando uma selfie com garrafas de Coca-Cola"
      loading="lazy"
      class="w-full rounded-card border border-ink object-cover shadow-solid-lg lg:h-full"
      data-reveal
    />
  </div>
</section>

<script>
  import { revealWords, revealOnScroll } from '../../lib/motion';
  revealWords('#talentos [data-reveal-words]');
  revealOnScroll('#talentos [data-reveal]', { atraso: 0.15 });
</script>
