---
import { asset } from '../../lib/url';
/**
 * Perguntas frequentes — Figma desktop 4016:326 · mobile 4031:3326.
 *
 * Acordeão com <details>/<summary>: abre e fecha sem JS, é navegável por
 * teclado de graça e o `name` compartilhado deixa só um aberto por vez.
 */
import RevealText from '../RevealText.astro';
import { FAQ } from '../../data/faq';
---

<section id="faq" class="relative overflow-hidden px-6 py-16 lg:px-28 lg:py-25">
  <!-- Mesma ancoragem do selo em Talentos: caixa de 1440 centrada. -->
  <div class="pointer-events-none absolute inset-0 mx-auto max-w-[1440px] overflow-hidden max-lg:hidden">
    <img
      src={asset('/images/faq/garrafa.svg')}
      alt=""
      aria-hidden="true"
      width="646"
      height="739"
      loading="lazy"
      class="absolute -right-[247px] -top-0.5 h-[739px] w-[646px]"
    />
  </div>

  <div class="relative mx-auto max-w-lp">
    <RevealText as="h2" class="h2" text="Perguntas frequentes" />

    <div class="mt-16 flex w-full max-w-[800px] flex-col gap-4" data-reveal-stagger>
      {
        FAQ.map((item) => (
          <details name="faq" class="faq-item group rounded-3xl bg-surface-alt p-6">
            <!-- leading-6 casa a linha do texto com os 24px do ícone: o item fecha em
                 72px, como no Figma (4016:336). -->
            <summary class="flex list-none items-start justify-between gap-4 text-lg leading-6">
              {item.pergunta}
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="size-6 shrink-0 text-brand transition-transform duration-200 group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>

            {item.resposta ? (
              <p class="body mt-4">{item.resposta}</p>
            ) : (
              /* Resposta ainda não recebida — ver src/data/faq.ts */
              <p class="body mt-4 italic" data-pendente>
                Resposta pendente de conteúdo do cliente.
              </p>
            )}
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { revealWords, revealStagger } from '../../lib/motion';
  revealWords('#faq [data-reveal-words]');
  revealStagger('#faq [data-reveal-stagger]');
</script>
