---
import { asset } from '../lib/url';
/**
 * Rodapé — Figma 4016:482 (bloco vermelho) e 4016:507 (faixa legal).
 * Mobile: 4031:2952 e 4031:2992.
 *
 * A assinatura "Paixão que transforma. / Sede que impulsiona." é vetor no
 * Figma; aqui vira texto de verdade — mesmo desenho, e legível por leitor
 * de tela e por busca.
 */
import Instagram from './icons/Instagram.astro';
import LinkedIn from './icons/LinkedIn.astro';
import YouTube from './icons/YouTube.astro';
import { SOCIAL_LINKS, LEGAL_LINKS, MAATZ_URL, EURECA_URL, SITE_NAME } from '../data/site';

const ICONS = { Instagram, LinkedIn, YouTube };
---

<footer>
  <div
    class="mx-auto flex max-w-[1440px] flex-col items-center gap-10 rounded-t-3xl lg:rounded-t-[40px] bg-brand respiro-x-rodape py-10 lg:flex-row lg:justify-between lg:py-20"
  >
    <a
      href={EURECA_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="alvo-44 -m-2 flex p-2 transition-opacity hover:opacity-70"
      aria-label="Eureca (abre em nova aba)"
    >
      <img
        src={asset('/images/brand/eureca.webp')}
        width="164"
        height="30"
        alt="Eureca"
        loading="lazy"
        class="h-6 w-auto lg:h-[30px]"
      />
    </a>

    <div class="flex flex-col items-center gap-[18px]">
      <img
        src={asset('/images/brand/logo-branco.svg')}
        width="268"
        height="28"
        alt={SITE_NAME}
        loading="lazy"
        class="h-7 w-auto"
      />
      <p class="text-center text-lg leading-6 text-surface">
        <strong class="font-bold">Paixão</strong> que transforma.<br />
        <strong class="font-bold">Sede</strong> que impulsiona.
      </p>
    </div>

    <ul class="flex items-center gap-2">
      {
        SOCIAL_LINKS.map((social) => {
          const Icon = ICONS[social.icon];
          return (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link alvo-44 flex size-10 items-center justify-center rounded-full bg-surface text-ink"
              >
                <Icon class="size-6" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="bg-ink">
    <div
      class="mx-auto flex max-w-[1440px] flex-col items-center justify-between gap-4 respiro-x-rodape py-6 text-sm lg:flex-row lg:py-6"
    >
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1">
        {
          LEGAL_LINKS.map((link) => {
            const externo = link.href.startsWith('http');
            return (
              <li>
                <a
                  href={link.href}
                  target={externo ? '_blank' : undefined}
                  rel={externo ? 'noopener noreferrer' : undefined}
                  class="alvo-44 inline-block text-ink-20 underline underline-offset-2 transition-colors hover:text-surface"
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- O link abraça "Desenvolvido por" + logo: alvo maior e uma frase só. -->
      <a
        href={MAATZ_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="alvo-44 -m-2 flex items-center gap-2 p-2 text-surface transition-opacity hover:opacity-70"
        aria-label="Desenvolvido por Maatz (abre em nova aba)"
      >
        Desenvolvido por
        <img
          src={asset('/images/brand/maatz-branco.svg')}
          width="72"
          height="18"
          alt="Maatz"
          loading="lazy"
          class="h-[18px] w-auto"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  .social-link {
    transition:
      transform 200ms ease,
      color 200ms ease;
  }
  .social-link:hover {
    transform: translateY(-2px);
    color: var(--color-brand);
  }
</style>
