---
/**
 * Rodapé — Figma 4016:482 (bloco vermelho) e 4016:507 (faixa legal).
 * Mobile: 4031:2952 e 4031:2992.
 *
 * A assinatura "Paixão que transforma. / Sede que impulsiona." é vetor no
 * Figma; aqui vira texto de verdade — mesmo desenho, e legível por leitor
 * de tela e por busca.
 */
import Instagram from './icons/Instagram.astro';
import LinkedIn from './icons/LinkedIn.astro';
import YouTube from './icons/YouTube.astro';
import { SOCIAL_LINKS, LEGAL_LINKS, SITE_NAME } from '../data/site';

const ICONS = { Instagram, LinkedIn, YouTube };
---

<footer>
  <div
    class="mx-auto flex max-w-[1440px] flex-col items-center gap-10 rounded-t-3xl lg:rounded-t-[40px] bg-brand px-6 py-16 lg:flex-row lg:justify-between lg:px-30 lg:py-20"
  >
    <img
      src="/images/brand/eureca.webp"
      width="164"
      height="30"
      alt="Eureca"
      loading="lazy"
      class="h-[30px] w-auto"
    />

    <div class="flex flex-col items-center gap-[18px]">
      <img
        src="/images/brand/logo-branco.svg"
        width="268"
        height="28"
        alt={SITE_NAME}
        loading="lazy"
        class="h-7 w-auto"
      />
      <p class="text-center text-lg leading-6 text-surface">
        <strong class="font-bold">Paixão</strong> que transforma.<br />
        <strong class="font-bold">Sede</strong> que impulsiona.
      </p>
    </div>

    <ul class="flex items-center gap-2">
      {
        SOCIAL_LINKS.map((social) => {
          const Icon = ICONS[social.icon];
          return (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link flex size-10 items-center justify-center rounded-full bg-surface text-ink"
              >
                <Icon class="size-6" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="bg-ink">
    <div
      class="mx-auto flex max-w-[1440px] flex-col items-center justify-between gap-4 px-6 py-6 text-sm lg:flex-row lg:px-30 lg:py-6"
    >
      <ul class="flex flex-wrap items-center justify-center gap-4">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-ink-20 underline underline-offset-2 transition-colors hover:text-surface">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="flex items-center gap-2 text-surface">
        Desenvolvido por
        <img src="/images/brand/maatz-branco.svg" width="72" height="18" alt="Maatz" loading="lazy" class="h-[18px] w-auto" />
      </p>
    </div>
  </div>
</footer>

<style>
  .social-link {
    transition:
      transform 200ms ease,
      color 200ms ease;
  }
  .social-link:hover {
    transform: translateY(-2px);
    color: var(--color-brand);
  }
</style>
